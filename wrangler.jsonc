{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "maderalab",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "maderalab.ricardober.world", "custom_domain": true }
  ]
}
